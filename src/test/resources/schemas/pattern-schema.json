{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generated schema for Root",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "age": {
      "type": "number"
    },
    "boolean": {
      "type": "boolean"
    },
    "address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "zip": {
          "type": "string"
        }
      },
      "required": [
        "street",
        "city",
        "zip"
      ]
    },
    "phoneNumbers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "number": {
            "type": "string",
            "pattern": "^\\d{3}-\\d{4}$"
          }
        },
        "required": [
          "type",
          "number"
        ]
      }
    }
  },
  "required": [
    "name",
    "age",
    "boolean",
    "address",
    "phoneNumbers"
  ]
}